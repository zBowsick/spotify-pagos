# Copia este archivo a .env (NUNCA lo subas a control de versiones).
# Obtén los valores en https://supabase.com/dashboard -> Settings -> API.

# --- Entorno ---
NODE_ENV=development
PORT=3000

# --- Supabase (project) ---
# Project URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ...

# --- Supabase (server-side, solo para scripts de DB) ---
# Service Role Key: tiene acceso total a la BD. NO la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ...

# --- Stripe (opcional, para cobros reales) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (opcional, para notificaciones de comprobantes) ---
# RESEND_API_KEY=re_...